{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./out-types-node",
    "types": ["node"],
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/shared/**/*.json",
    "electron.vite.config.ts"
  ],
  "exclude": ["**/*.test.ts"],
  "references": [{ "path": "../clash-core" }]
}
