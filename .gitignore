# Dependency directories
node_modules/

# Build output
dist/
build/
out/
*.tsbuildinfo
# desktop: typecheck output (tsconfig.node/web outDir), old electron-vite
# builds and the temp configs electron-vite leaves behind when it crashes
packages/desktop/out-types-*/
packages/desktop/out.old*/
packages/desktop/electron.vite.config.*.mjs

# Rust build artefacts (engine)
engine/target/

# Test / coverage output
coverage/
.vitest-cache/

# Logs
*.log
npm-debug.log*

# OS junk
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp

# Environment
.env
.env.local

# Generated outputs (real clash runs)
outputs/
*.bcf
*.bcfzip

# Allow our example outputs through if needed (override in subfolder)
!examples/**/expected/*.bcf

# Maintainers' private working notes — never committed. They live in the
# Dropbox project folder; `internal` is a symlink to it (no trailing slash:
# git sees a symlink as a file). The lines below it are a safety net.
/internal
TASKS.md
STATUS.md
CLAUDE.md
SPEC.md
PLAN.md
M*_PROGRESS.md
research/
