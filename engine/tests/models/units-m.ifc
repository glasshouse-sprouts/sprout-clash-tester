ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Clash Tester fixture: units (T13), m'),'2;1');
FILE_NAME('units-m.ifc','2026-10-31T00:00:00',('Clash Tester'),(''),'hand-written','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Same scene in both files; this one in m. Slab 2 x 2 x 0.2 m; three ducts. */
#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#2=IFCUNITASSIGNMENT((#1));
#3=IFCCARTESIANPOINT((0.,0.,0.));
#4=IFCAXIS2PLACEMENT3D(#3,$,$);
#5=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#4,$);
#6=IFCPROJECT('0PRJUNITS000000000000M',$,'Units fixture',$,$,$,$,(#5),#2);
#7=IFCLOCALPLACEMENT($,#4);
#8=IFCDIRECTION((0.,0.,1.));
/* Slab: x 0..2, y 0..2, z 0..0.2 */
#10=IFCCARTESIANPOINT((1.,1.));
#11=IFCAXIS2PLACEMENT2D(#10,$);
#12=IFCRECTANGLEPROFILEDEF(.AREA.,$,#11,2.,2.);
#13=IFCCARTESIANPOINT((0.,0.,0.));
#14=IFCAXIS2PLACEMENT3D(#13,$,$);
#15=IFCEXTRUDEDAREASOLID(#12,#14,#8,0.2);
#16=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#15));
#17=IFCPRODUCTDEFINITIONSHAPE($,$,(#16));
#18=IFCSLAB('0SLAB0000000000000UNITS',$,'Slab: x 0..2, y 0..2, z 0..0.2',$,$,#7,#17,$,.FLOOR.);
/* Duct 3 mm into the slab: z 0.197..0.5 */
#20=IFCCARTESIANPOINT((0.3,1.));
#21=IFCAXIS2PLACEMENT2D(#20,$);
#22=IFCRECTANGLEPROFILEDEF(.AREA.,$,#21,0.2,0.2);
#23=IFCCARTESIANPOINT((0.,0.,0.197));
#24=IFCAXIS2PLACEMENT3D(#23,$,$);
#25=IFCEXTRUDEDAREASOLID(#22,#24,#8,0.303);
#26=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#25));
#27=IFCPRODUCTDEFINITIONSHAPE($,$,(#26));
#28=IFCDUCTSEGMENT('0DUCT00000000000SHALLOW',$,'Duct 3 mm into the slab: z 0.197..0.5',$,$,#7,#27,$,.RIGIDSEGMENT.);
/* Duct 20 mm into the slab: z 0.18..0.5 */
#30=IFCCARTESIANPOINT((1.1,1.));
#31=IFCAXIS2PLACEMENT2D(#30,$);
#32=IFCRECTANGLEPROFILEDEF(.AREA.,$,#31,0.2,0.2);
#33=IFCCARTESIANPOINT((0.,0.,0.18));
#34=IFCAXIS2PLACEMENT3D(#33,$,$);
#35=IFCEXTRUDEDAREASOLID(#32,#34,#8,0.32);
#36=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#35));
#37=IFCPRODUCTDEFINITIONSHAPE($,$,(#36));
#38=IFCDUCTSEGMENT('0DUCT0000000000000DEEP0',$,'Duct 20 mm into the slab: z 0.18..0.5',$,$,#7,#37,$,.RIGIDSEGMENT.);
/* Duct 40 mm above the slab: z 0.24..0.5 */
#40=IFCCARTESIANPOINT((1.7,1.));
#41=IFCAXIS2PLACEMENT2D(#40,$);
#42=IFCRECTANGLEPROFILEDEF(.AREA.,$,#41,0.2,0.2);
#43=IFCCARTESIANPOINT((0.,0.,0.24));
#44=IFCAXIS2PLACEMENT3D(#43,$,$);
#45=IFCEXTRUDEDAREASOLID(#42,#44,#8,0.26);
#46=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#45));
#47=IFCPRODUCTDEFINITIONSHAPE($,$,(#46));
#48=IFCDUCTSEGMENT('0DUCT0000000000000NEAR0',$,'Duct 40 mm above the slab: z 0.24..0.5',$,$,#7,#47,$,.RIGIDSEGMENT.);
ENDSEC;
END-ISO-10303-21;
