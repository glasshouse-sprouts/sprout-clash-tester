ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Clash Tester fixture: geometry that cannot be read'),'2;1');
FILE_NAME('geometry-failed.ifc','2026-11-08T00:00:00',('Clash Tester'),(''),'hand-written','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* One good slab; two elements with a Body that gives no mesh (counted);
   a roof without any representation and a 2D annotation (not counted). */
#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#2=IFCUNITASSIGNMENT((#1));
#3=IFCCARTESIANPOINT((0.,0.,0.));
#4=IFCAXIS2PLACEMENT3D(#3,$,$);
#5=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#4,$);
#6=IFCPROJECT('0PRJGEOMFAILED000000000',$,'Geometry fixture',$,$,$,$,(#5),#2);
#7=IFCLOCALPLACEMENT($,#4);
#8=IFCDIRECTION((0.,0.,1.));
/* Good slab: x 0..2, y 0..2, z 0..0.2 */
#10=IFCCARTESIANPOINT((1.,1.));
#11=IFCAXIS2PLACEMENT2D(#10,$);
#12=IFCRECTANGLEPROFILEDEF(.AREA.,$,#11,2.,2.);
#15=IFCEXTRUDEDAREASOLID(#12,#4,#8,0.2);
#16=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#15));
#17=IFCPRODUCTDEFINITIONSHAPE($,$,(#16));
#18=IFCSLAB('0SLAB00000000000000GOOD',$,'Good slab',$,$,#7,#17,$,.FLOOR.);
/* Broken: the extrusion's profile is a point, not a profile */
#20=IFCEXTRUDEDAREASOLID(#10,#4,#8,0.5);
#21=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#20));
#22=IFCPRODUCTDEFINITIONSHAPE($,$,(#21));
#23=IFCBUILDINGELEMENTPROXY('0PROXY0000000000BROKEN1',$,'Broken extrusion',$,$,#7,#22,$,$);
/* Broken: a Body that is only a line */
#30=IFCCARTESIANPOINT((0.,0.,1.));
#31=IFCCARTESIANPOINT((2.,2.,1.));
#32=IFCPOLYLINE((#30,#31));
#33=IFCSHAPEREPRESENTATION(#5,'Body','Curve3D',(#32));
#34=IFCPRODUCTDEFINITIONSHAPE($,$,(#33));
#35=IFCBEAM('0BEAM00000000000BROKEN2',$,'Body that is a line',$,$,#7,#34,$,$);
/* Not geometry: a roof that only aggregates (no representation) */
#40=IFCROOF('0ROOF0000000000000EMPTY',$,'Container roof',$,$,#7,$,$,$);
/* Not geometry we test: a 2D plan annotation */
#50=IFCCARTESIANPOINT((0.,0.));
#51=IFCCARTESIANPOINT((1.,0.));
#52=IFCPOLYLINE((#50,#51));
#53=IFCGEOMETRICCURVESET((#52));
#54=IFCSHAPEREPRESENTATION(#5,'Annotation','Annotation2D',(#53));
#55=IFCPRODUCTDEFINITIONSHAPE($,$,(#54));
#56=IFCANNOTATION('0ANNO000000000000PLAN2D',$,'Dimension line',$,$,#7,#55,$);
ENDSEC;
END-ISO-10303-21;
