ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Clash Tester fixture: IFC2X3 MEP occurrences typed by type objects (T15)'),'2;1');
FILE_NAME('ifc2x3-mep-types.ifc','2026-11-03T00:00:00',('Clash Tester'),(''),'hand-written','','');
FILE_SCHEMA(('IFC2X3'));
ENDSEC;
DATA;
/* Beam x 0..4, y 0..1, z 0..0.3. Four 0.2 x 0.2 boxes stand through it, z -0.2..0.5. */
#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#2=IFCUNITASSIGNMENT((#1));
#3=IFCCARTESIANPOINT((0.,0.,0.));
#4=IFCAXIS2PLACEMENT3D(#3,$,$);
#5=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#4,$);
#6=IFCPROJECT('0PRJ2X3MEP000000000000',$,'IFC2X3 MEP types fixture',$,$,$,$,(#5),#2);
#7=IFCLOCALPLACEMENT($,#4);
#8=IFCDIRECTION((0.,0.,1.));
#10=IFCCARTESIANPOINT((2.,0.5));
#11=IFCAXIS2PLACEMENT2D(#10,$);
#12=IFCRECTANGLEPROFILEDEF(.AREA.,$,#11,4.,1.);
#13=IFCEXTRUDEDAREASOLID(#12,#4,#8,0.3);
#14=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#13));
#15=IFCPRODUCTDEFINITIONSHAPE($,$,(#14));
#16=IFCBEAM('0BEAM00000000000002X3MEP',$,'Beam',$,$,#7,#15,$);
#17=IFCCARTESIANPOINT((0.,0.,-0.2));
#18=IFCAXIS2PLACEMENT3D(#17,$,$);
/* Duct segment, typed: x 0.4..0.6 */
#20=IFCCARTESIANPOINT((0.5,0.5));
#21=IFCAXIS2PLACEMENT2D(#20,$);
#22=IFCRECTANGLEPROFILEDEF(.AREA.,$,#21,0.2,0.2);
#23=IFCEXTRUDEDAREASOLID(#22,#18,#8,0.7);
#24=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#23));
#25=IFCPRODUCTDEFINITIONSHAPE($,$,(#24));
#26=IFCFLOWSEGMENT('0DUCTSEG0000000002X3MEP',$,'Duct segment, typed',$,$,#7,#25,$);
/* Pipe segment, typed: x 1.4..1.6 */
#30=IFCCARTESIANPOINT((1.5,0.5));
#31=IFCAXIS2PLACEMENT2D(#30,$);
#32=IFCRECTANGLEPROFILEDEF(.AREA.,$,#31,0.2,0.2);
#33=IFCEXTRUDEDAREASOLID(#32,#18,#8,0.7);
#34=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#33));
#35=IFCPRODUCTDEFINITIONSHAPE($,$,(#34));
#36=IFCFLOWSEGMENT('0PIPESEG0000000002X3MEP',$,'Pipe segment, typed',$,$,#7,#35,$);
/* Duct fitting, typed: x 2.4..2.6 */
#40=IFCCARTESIANPOINT((2.5,0.5));
#41=IFCAXIS2PLACEMENT2D(#40,$);
#42=IFCRECTANGLEPROFILEDEF(.AREA.,$,#41,0.2,0.2);
#43=IFCEXTRUDEDAREASOLID(#42,#18,#8,0.7);
#44=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#43));
#45=IFCPRODUCTDEFINITIONSHAPE($,$,(#44));
#46=IFCFLOWFITTING('0DUCTFIT0000000002X3MEP',$,'Duct fitting, typed',$,$,#7,#45,$);
/* Flow segment without a type object: x 3.4..3.6 */
#50=IFCCARTESIANPOINT((3.5,0.5));
#51=IFCAXIS2PLACEMENT2D(#50,$);
#52=IFCRECTANGLEPROFILEDEF(.AREA.,$,#51,0.2,0.2);
#53=IFCEXTRUDEDAREASOLID(#52,#18,#8,0.7);
#54=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#53));
#55=IFCPRODUCTDEFINITIONSHAPE($,$,(#54));
#56=IFCFLOWSEGMENT('0UNTYPED0000000002X3MEP',$,'Flow segment without a type object',$,$,#7,#55,$);
/* Type objects (IFC2X3: PredefinedType is attribute 10) */
#60=IFCDUCTSEGMENTTYPE('0DUCTSEGTYPE00002X3MEP0',$,'Duct',$,$,$,$,$,$,.RIGIDSEGMENT.);
#61=IFCPIPESEGMENTTYPE('0PIPESEGTYPE00002X3MEP0',$,'Pipe',$,$,$,$,$,$,.NOTDEFINED.);
#62=IFCDUCTFITTINGTYPE('0DUCTFITTYPE00002X3MEP0',$,'Bend',$,$,$,$,$,$,.BEND.);
#70=IFCRELDEFINESBYTYPE('0RELTYPEDUCT0002X3MEP00',$,$,$,(#26),#60);
#71=IFCRELDEFINESBYTYPE('0RELTYPEPIPE0002X3MEP00',$,$,$,(#36),#61);
#72=IFCRELDEFINESBYTYPE('0RELTYPEFIT00002X3MEP00',$,$,$,(#46),#62);
ENDSEC;
END-ISO-10303-21;
