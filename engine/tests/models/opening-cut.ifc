ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Clash Tester fixture: one wall with one opening, two ducts (SPEC 13f)'),'2;1');
FILE_NAME('opening-cut.ifc','2026-10-31T00:00:00',('Clash Tester'),(''),'hand-written','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Units and context: metres, Z up. */
#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#2=IFCUNITASSIGNMENT((#1));
#3=IFCCARTESIANPOINT((0.,0.,0.));
#4=IFCAXIS2PLACEMENT3D(#3,$,$);
#5=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#4,$);
#6=IFCPROJECT('0PRJ000000000000000001',$,'Opening cut fixture',$,$,$,$,(#5),#2);
#7=IFCLOCALPLACEMENT($,#4);
#8=IFCDIRECTION((0.,0.,1.));
/* Wall: x 0..4, y 0..0.2, z 0..3. */
#10=IFCCARTESIANPOINT((2.,0.1));
#11=IFCAXIS2PLACEMENT2D(#10,$);
#12=IFCRECTANGLEPROFILEDEF(.AREA.,$,#11,4.,0.2);
#13=IFCEXTRUDEDAREASOLID(#12,#4,#8,3.);
#14=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#13));
#15=IFCPRODUCTDEFINITIONSHAPE($,$,(#14));
#16=IFCWALL('0WAL000000000000000001',$,'Wall',$,$,#7,#15,$,.STANDARD.);
/* Opening: x 1..2, y -0.1..0.3 (through the wall), z 1..2. */
#20=IFCCARTESIANPOINT((1.5,0.1));
#21=IFCAXIS2PLACEMENT2D(#20,$);
#22=IFCRECTANGLEPROFILEDEF(.AREA.,$,#21,1.,0.4);
#23=IFCCARTESIANPOINT((0.,0.,1.));
#24=IFCAXIS2PLACEMENT3D(#23,$,$);
#25=IFCEXTRUDEDAREASOLID(#22,#24,#8,1.);
#26=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#25));
#27=IFCPRODUCTDEFINITIONSHAPE($,$,(#26));
#28=IFCOPENINGELEMENT('0OPN000000000000000001',$,'Opening',$,$,#7,#27,$,.OPENING.);
#29=IFCRELVOIDSELEMENT('0RVO000000000000000001',$,$,$,#16,#28);
/* Duct through the opening: x 1.3..1.7, y -0.5..0.7, z 1.3..1.7. */
#30=IFCCARTESIANPOINT((1.5,0.1));
#31=IFCAXIS2PLACEMENT2D(#30,$);
#32=IFCRECTANGLEPROFILEDEF(.AREA.,$,#31,0.4,1.2);
#33=IFCCARTESIANPOINT((0.,0.,1.3));
#34=IFCAXIS2PLACEMENT3D(#33,$,$);
#35=IFCEXTRUDEDAREASOLID(#32,#34,#8,0.4);
#36=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#35));
#37=IFCPRODUCTDEFINITIONSHAPE($,$,(#36));
#38=IFCDUCTSEGMENT('0DCT000000000000THROUGH',$,'Duct through opening',$,$,#7,#37,$,.RIGIDSEGMENT.);
/* Duct through the solid part: x 3.0..3.4, same y and z. */
#40=IFCCARTESIANPOINT((3.2,0.1));
#41=IFCAXIS2PLACEMENT2D(#40,$);
#42=IFCRECTANGLEPROFILEDEF(.AREA.,$,#41,0.4,1.2);
#43=IFCEXTRUDEDAREASOLID(#42,#34,#8,0.4);
#44=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#43));
#45=IFCPRODUCTDEFINITIONSHAPE($,$,(#44));
#46=IFCDUCTSEGMENT('0DCT00000000000000SOLID',$,'Duct through wall',$,$,#7,#45,$,.RIGIDSEGMENT.);
ENDSEC;
END-ISO-10303-21;
